{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Open Chrome",
      "type": "shell",
      "command": "Start-Process chrome.exe 'http://localhost:5173'",
      "problemMatcher": []
    },
    {
      "label": "Start TaskFlow",
      "dependsOn": [
        "Start Backend",
        "Start Frontend",
        "Open Chrome"
      ],
      "dependsOrder": "parallel"
    }
  ]
}